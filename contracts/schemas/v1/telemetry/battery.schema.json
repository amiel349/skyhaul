{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatteryPayload",
  "description": "BATTERY: drone-initiated, every 5 s from spawn.",
  "type": "object",
  "required": [
    "charge_pct",
    "est_remaining_s"
  ],
  "properties": {
    "charge_pct": {
      "description": "Remaining charge in percent.",
      "$ref": "../common.schema.json#/$defs/Percent"
    },
    "est_remaining_s": {
      "description": "Estimated airborne seconds left at cruise speed.",
      "$ref": "../common.schema.json#/$defs/DurationS"
    }
  }
}
