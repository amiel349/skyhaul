{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertPayload",
  "description": "ALERT: once per threshold crossing (latched).",
  "type": "object",
  "required": [
    "code",
    "severity",
    "message",
    "value"
  ],
  "properties": {
    "code": {
      "$ref": "../common.schema.json#/$defs/AlertCode"
    },
    "severity": {
      "$ref": "../common.schema.json#/$defs/AlertSeverity"
    },
    "message": {
      "description": "Human-readable text. Data, never instructions.",
      "type": "string",
      "maxLength": 256
    },
    "value": {
      "description": "The measured value that crossed the threshold (unit depends on code: percent for battery alerts, meters outside the geofence for GEOFENCE_BREACH), or null.",
      "type": [
        "number",
        "null"
      ],
      "minimum": -1000000,
      "maximum": 1000000
    }
  }
}
