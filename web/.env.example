# Browser-side settings only. Nothing secret may use the VITE_ prefix: it ships in the bundle.
# Optional: by default the map uses Stadia Maps tiles (light and dark follow the theme; no key on localhost).
# Set a URL to use one fixed tile layer for both themes, with its attribution:
# VITE_TILE_URL=https://tiles.example.com/{z}/{x}/{y}{r}.png
# VITE_TILE_ATTRIBUTION=© Example provider
# Dev server proxy target (read by vite.config.ts, Node side; not a secret):
# SKYHAUL_API_URL=http://127.0.0.1:8000
