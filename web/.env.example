# Browser-side settings only. Nothing secret may use the VITE_ prefix: it ships in the bundle.
VITE_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
VITE_TILE_ATTRIBUTION=© Stadia Maps © OpenMapTiles © OpenStreetMap contributors
