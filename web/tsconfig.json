{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client"],
    "paths": {
      "@skyhaul/contracts": ["../contracts/ts/index.ts"],
      "@contracts/*": ["../contracts/ts/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "../contracts/ts/**/*.ts",
    "../contracts/tests/ts/**/*.ts"
  ]
}
