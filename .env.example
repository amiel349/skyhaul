# Copy with `make env`: it creates .env and fills every empty secret with a random value.
# Never commit .env. Never put a real value in this file.

POSTGRES_USER=skyhaul
POSTGRES_DB=skyhaul
POSTGRES_PASSWORD=

RABBITMQ_USER=skyhaul
RABBITMQ_PASSWORD=

REDIS_PASSWORD=

# Bearer token of the simulator's test-only control API (at least 32 characters)
SIM_CONTROL_TOKEN=

# Signs access tokens (M2)
JWT_SECRET=

# Only needed for the real-model copilot and nightly evals (M5). PR CI uses the fake LLM.
# Use a dedicated key with a spend limit.
ANTHROPIC_API_KEY=
