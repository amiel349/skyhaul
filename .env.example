# Copy with `make env`: it creates .env and fills every empty secret with a random value.
# Never commit .env. Never put a real value in this file.

# Bootstrap superuser of the Postgres container. No service connects with it.
POSTGRES_USER=skyhaul
POSTGRES_DB=skyhaul
POSTGRES_PASSWORD=
# Service roles (deploy/postgres/initdb.d): schema owner and migrations, API, ingestor.
DB_OWNER_PASSWORD=
DB_API_PASSWORD=
DB_INGESTOR_PASSWORD=

# Admin broker user: broker-init, and in M2 the simulator and MCP server (test profile).
RABBITMQ_USER=skyhaul
RABBITMQ_PASSWORD=
# Per-service broker users created by broker-init: skyhaul_api and skyhaul_ingestor.
AMQP_API_PASSWORD=
AMQP_INGESTOR_PASSWORD=

REDIS_PASSWORD=

# Bearer token of the simulator's test-only control API (at least 32 characters)
SIM_CONTROL_TOKEN=

# Signs access tokens (M2)
JWT_SECRET=

# Local development login, created or synced by `make up` (profile dev; not for a deploy).
# `make env` generates a random password: edit it in .env to any password you like, even `1234`:
# unlike the API (12+ characters), this local-only admin accepts a short one. Empty = skip it.
DEV_ADMIN_EMAIL=admin@skyhaul.dev
DEV_ADMIN_PASSWORD=

# Only needed for the real-model copilot and nightly evals (M5). PR CI uses the fake LLM.
# Use a dedicated key with a spend limit.
ANTHROPIC_API_KEY=
